# Copy this file to `.env` and fill in your values. `.env` is gitignored and
# loaded automatically by config/runtime.exs (via dotenvy) on `mix phx.server`.
# Real environment variables always override these.

# Which weather provider Sync uses: "xweather" (default if unset) or "openweather".
# WEATHER_PROVIDER=xweather

# Xweather (https://www.xweather.com) client credentials — the default provider.
# Register at https://www.xweather.com/account to get a client_id/client_secret pair.
# Leave unset to run without weather (the dashboard degrades gracefully).
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# OpenWeatherMap API key (free tier) — an alternate provider, set
# WEATHER_PROVIDER=openweather to use it. Get one at https://openweathermap.org/api
# Known limitation: OWM's daily forecast reliably omits icon/condition data.
WEATHER_API_KEY=

# Settings/admin area credentials (the shared-password gate on /admin and /oban).
# Optional in dev/test (defaults: family / family-dashboard); required in prod.
SETTINGS_USERNAME=family
SETTINGS_PASSWORD=family-dashboard

# HTTP port for the server (optional; defaults to 4000).
# PORT=4000
